rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Admins — any authenticated user can read (needed for client-side isAdmin() check)
    match /admins/{docId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Users (customer list) — owner or admin can read; written only by Cloud Functions (admin SDK)
    match /users/{uid} {
      allow read: if request.auth != null
        && (request.auth.uid == uid
            || exists(/databases/$(database)/documents/admins/$(request.auth.uid)));
      allow write: if false;
    }

    // "What does this plate mean?" answers (with emails) — written by the
    // recordPlateMeaning function; admin read only. Not plate_meanings, which is public.
    match /owner_plate_meanings/{docId} {
      allow read: if request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
      allow write: if false;
    }

    // "Would you sell?" answers — written by the recordSellIntent function; admin read only
    match /sell_intents/{docId} {
      allow read: if request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
      allow write: if false;
    }

    // Rate limits — Cloud Functions only (admin SDK)
    match /rate_limits/{docId} {
      allow read, write: if false;
    }

    // Valuations — authenticated users can read/write their own
    match /valuations/{docId} {
      allow read, write: if request.auth != null && request.auth.uid == resource.data.userId;
    }

    // Auto valuations — public write; admin read only
    match /auto_valuations/{docId} {
      allow create: if true;
      allow read: if request.auth != null && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
      allow update, delete: if false;
    }

    // Plate searches — public write; admin read only
    match /plate_searches/{docId} {
      allow create: if true;
      allow read: if request.auth != null && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
      allow update, delete: if false;
    }

    // Valuation feedback — public write; admin read only
    match /valuation_feedback/{docId} {
      allow create: if true;
      allow read: if request.auth != null && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
      allow update, delete: if false;
    }

    // Plate valuation message feedback — public write; admin read only
    match /plate_valuation_message_feedback/{docId} {
      allow create: if true;
      allow read: if request.auth != null && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
      allow update, delete: if false;
    }

    // Feature requests — write only
    match /feature_requests/{docId} {
      allow create: if true;
      allow read, update, delete: if false;
    }

    // Mail — triggers real email sends via Firebase Extension. Clients may only
    // send admin notifications; everything else goes through Cloud Functions.
    match /mail/{docId} {
      allow create: if request.auth != null
        && request.resource.data.to == ['guv.mr.valuations@gmail.com'];
      allow read, update, delete: if false;
    }

    // Seller enquiries — conversations written only by Cloud Functions; the
    // seller and the buyer can read their own; admins can read all
    match /seller_enquiries/{docId} {
      allow create: if false;
      allow read: if request.auth != null
        && (request.auth.token.email == resource.data.sellerEmail
            || request.auth.uid == resource.data.buyerUid
            || exists(/databases/$(database)/documents/admins/$(request.auth.uid)));
      // Each side may only stamp when it last opened the conversation, which
      // drives the unread count. Admins read the legacy listings' enquiries.
      allow update: if request.auth != null
        && request.resource.data.diff(resource.data).affectedKeys().size() == 1
        && ((request.resource.data.diff(resource.data).affectedKeys().hasOnly(['sellerReadAt'])
             && request.resource.data.sellerReadAt == request.time
             && (request.auth.token.email == resource.data.sellerEmail
                 || exists(/databases/$(database)/documents/admins/$(request.auth.uid))))
          || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['buyerReadAt'])
             && request.resource.data.buyerReadAt == request.time
             && request.auth.uid == resource.data.buyerUid));
      allow delete: if false;

      // Every message in the conversation. The seller can't read them until
      // they've paid to unlock the enquiry; the buyer always can.
      match /messages/{messageId} {
        allow read: if request.auth != null
          && (request.auth.uid == get(/databases/$(database)/documents/seller_enquiries/$(docId)).data.buyerUid
              || (request.auth.token.email == get(/databases/$(database)/documents/seller_enquiries/$(docId)).data.sellerEmail
                  && get(/databases/$(database)/documents/seller_enquiries/$(docId)).data.locked != true)
              || exists(/databases/$(database)/documents/admins/$(request.auth.uid)));
        allow write: if false;
      }
    }

    // New plate listings — publicly readable; owner can update price/meanings; only server can create
    match /plate-listings-new/{docId} {
      allow read: if true;
      allow update: if request.auth != null && (
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['viewsPlaceholder']) ||
        (
          request.auth.uid == resource.data.sellerUid &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['askingPrice', 'meanings'])
        )
      );
      allow create, delete: if false;

      // Seller contact details — Cloud Functions only
      match /private/{docId} {
        allow read, write: if false;
      }
    }

    // Button metrics — public write (track clicks from guests too); admin read only
    match /button_metrics/{docId} {
      allow create, update: if true;
      allow read: if request.auth != null && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
      allow delete: if false;
    }

    // Legacy plate listings — publicly readable, view increment only
    match /plate-listings/{docId} {
      allow read: if true;
      allow update: if request.auth != null && (
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['viewsPlaceholder']) ||
        (
          request.auth.uid == resource.data.sellerUid &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['askingPrice', 'meanings'])
        )
      );
      allow create, delete: if false;

      // Seller contact details — Cloud Functions only
      match /private/{docId} {
        allow read, write: if false;
      }
    }

    // Buyer searches — public write; admin read only
    match /buyer_searches/{docId} {
      allow create: if true;
      allow read: if request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
      allow update, delete: if false;
    }

    // Nudge queue — admin read only; written exclusively by Cloud Functions (admin SDK)
    match /listing_nudge_queue/{docId} {
      allow read: if request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
      allow write: if false;
    }

    // Vouchers — public marketing codes are publicly readable (queried by audience);
    // personal nudge codes are not publicly queryable. Written only by Cloud Functions.
    match /vouchers/{docId} {
      allow read: if resource.data.audience == 'public';
      allow write: if false;
    }

    // Articles — publicly readable; written only by Cloud Function (admin SDK bypasses rules)
    match /articles/{articleId} {
      allow read: if true;
      allow write: if false;
    }

    // Plate meaning descriptions — publicly readable; written only by Cloud Function
    match /plate_meanings/{plate} {
      allow read: if true;
      allow write: if false;
    }

    // Trust-strip numbers — publicly readable; written only by refreshPublicStats
    match /public_stats/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // Meta (used keywords, generation log) — Cloud Function only (admin SDK)
    match /meta/{docId} {
      allow read, write: if false;
    }
  }
}
